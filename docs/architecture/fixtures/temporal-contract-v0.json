{
  "format": "meridiandb-temporal-contract-v0",
  "timeUnit": "integer microseconds since Unix epoch",
  "status": "experimental contract; exercised by the reference model and memory-only engine",
  "histories": [
    {
      "id": "salary",
      "description": "Bounded correction, retraction, stable views, historical queries and retry identity.",
      "steps": [
        {
          "id": "genesis-empty",
          "kind": "query",
          "cutoff": 0,
          "query": {
            "kind": "get",
            "entity": "alice",
            "validAt": 1771113600000000
          },
          "expected": {
            "present": false
          }
        },
        {
          "id": "insert-two-entities",
          "kind": "transact",
          "requestId": "initial",
          "operations": [
            {
              "op": "put",
              "entity": "alice",
              "from": 1767225600000000,
              "to": null,
              "value": 70000
            },
            {
              "op": "put",
              "entity": "bob",
              "from": 1767225600000000,
              "to": null,
              "value": 60000
            }
          ],
          "expected": {
            "status": "committed",
            "commit": 1,
            "replayed": false
          }
        },
        {
          "id": "pin-before-correction",
          "kind": "openView",
          "viewId": "before",
          "cutoff": "head",
          "expected": {
            "commit": 1
          }
        },
        {
          "id": "current-before-correction",
          "kind": "query",
          "cutoff": "head",
          "query": {
            "kind": "get",
            "entity": "alice",
            "validAt": 1771113600000000
          },
          "expected": {
            "present": true,
            "value": 70000
          }
        },
        {
          "id": "aggregate-before-correction",
          "kind": "query",
          "cutoff": 1,
          "query": {
            "kind": "sum",
            "entities": [
              "alice",
              "bob"
            ],
            "validAt": 1771113600000000
          },
          "expected": {
            "count": 2,
            "sum": "130000"
          }
        },
        {
          "id": "bounded-retroactive-correction",
          "kind": "transact",
          "requestId": "correction",
          "operations": [
            {
              "op": "put",
              "entity": "alice",
              "from": 1769904000000000,
              "to": 1772323200000000,
              "value": 75000
            }
          ],
          "expected": {
            "status": "committed",
            "commit": 2,
            "replayed": false
          }
        },
        {
          "id": "current-after-correction",
          "kind": "query",
          "cutoff": "head",
          "query": {
            "kind": "get",
            "entity": "alice",
            "validAt": 1771113600000000
          },
          "expected": {
            "present": true,
            "value": 75000
          }
        },
        {
          "id": "past-cutoff-unchanged",
          "kind": "query",
          "cutoff": 1,
          "query": {
            "kind": "get",
            "entity": "alice",
            "validAt": 1771113600000000
          },
          "expected": {
            "present": true,
            "value": 70000
          }
        },
        {
          "id": "before-valid-start",
          "kind": "query",
          "cutoff": 2,
          "query": {
            "kind": "get",
            "entity": "alice",
            "validAt": 1767225599999999
          },
          "expected": {
            "present": false
          }
        },
        {
          "id": "correction-start-inclusive",
          "kind": "query",
          "cutoff": 2,
          "query": {
            "kind": "get",
            "entity": "alice",
            "validAt": 1769904000000000
          },
          "expected": {
            "present": true,
            "value": 75000
          }
        },
        {
          "id": "one-microsecond-before-start",
          "kind": "query",
          "cutoff": 2,
          "query": {
            "kind": "get",
            "entity": "alice",
            "validAt": 1769903999999999
          },
          "expected": {
            "present": true,
            "value": 70000
          }
        },
        {
          "id": "correction-end-exclusive",
          "kind": "query",
          "cutoff": 2,
          "query": {
            "kind": "get",
            "entity": "alice",
            "validAt": 1772323200000000
          },
          "expected": {
            "present": true,
            "value": 70000
          }
        },
        {
          "id": "clipped-interval-scan",
          "kind": "query",
          "cutoff": 2,
          "query": {
            "kind": "scan",
            "entity": "alice",
            "from": 1767225600000000,
            "to": 1775001600000000
          },
          "expected": [
            {
              "from": 1767225600000000,
              "to": 1769904000000000,
              "value": 70000
            },
            {
              "from": 1769904000000000,
              "to": 1772323200000000,
              "value": 75000
            },
            {
              "from": 1772323200000000,
              "to": 1775001600000000,
              "value": 70000
            }
          ]
        },
        {
          "id": "aggregate-after-correction",
          "kind": "query",
          "cutoff": 2,
          "query": {
            "kind": "sum",
            "entities": [
              "alice",
              "bob"
            ],
            "validAt": 1771113600000000
          },
          "expected": {
            "count": 2,
            "sum": "135000"
          }
        },
        {
          "id": "partial-retraction",
          "kind": "transact",
          "requestId": "retraction",
          "operations": [
            {
              "op": "retract",
              "entity": "alice",
              "from": 1770681600000000,
              "to": 1771545600000000
            }
          ],
          "expected": {
            "status": "committed",
            "commit": 3,
            "replayed": false
          }
        },
        {
          "id": "retraction-start-inclusive",
          "kind": "query",
          "cutoff": 3,
          "query": {
            "kind": "get",
            "entity": "alice",
            "validAt": 1770681600000000
          },
          "expected": {
            "present": false
          }
        },
        {
          "id": "retraction-end-exclusive",
          "kind": "query",
          "cutoff": 3,
          "query": {
            "kind": "get",
            "entity": "alice",
            "validAt": 1771545600000000
          },
          "expected": {
            "present": true,
            "value": 75000
          }
        },
        {
          "id": "retraction-gap-in-scan",
          "kind": "query",
          "cutoff": 3,
          "query": {
            "kind": "scan",
            "entity": "alice",
            "from": 1769904000000000,
            "to": 1772323200000000
          },
          "expected": [
            {
              "from": 1769904000000000,
              "to": 1770681600000000,
              "value": 75000
            },
            {
              "from": 1771545600000000,
              "to": 1772323200000000,
              "value": 75000
            }
          ]
        },
        {
          "id": "aggregate-ignores-absence",
          "kind": "query",
          "cutoff": 3,
          "query": {
            "kind": "sum",
            "entities": [
              "alice",
              "bob"
            ],
            "validAt": 1771113600000000
          },
          "expected": {
            "count": 1,
            "sum": "60000"
          }
        },
        {
          "id": "historical-correction-survives",
          "kind": "query",
          "cutoff": 2,
          "query": {
            "kind": "get",
            "entity": "alice",
            "validAt": 1771113600000000
          },
          "expected": {
            "present": true,
            "value": 75000
          }
        },
        {
          "id": "pinned-view-survives",
          "kind": "query",
          "viewId": "before",
          "query": {
            "kind": "get",
            "entity": "alice",
            "validAt": 1771113600000000
          },
          "expected": {
            "present": true,
            "value": 70000
          }
        },
        {
          "id": "resolve-lost-acknowledgement",
          "kind": "lookupRequest",
          "requestId": "correction",
          "expected": {
            "status": "committed",
            "commit": 2
          }
        },
        {
          "id": "retry-after-later-commit",
          "kind": "transact",
          "requestId": "correction",
          "operations": [
            {
              "op": "put",
              "entity": "alice",
              "from": 1769904000000000,
              "to": 1772323200000000,
              "value": 75000
            }
          ],
          "expected": {
            "status": "committed",
            "commit": 2,
            "replayed": true
          }
        },
        {
          "id": "retry-does-not-advance-head",
          "kind": "openView",
          "viewId": "after-retry",
          "cutoff": "head",
          "expected": {
            "commit": 3
          }
        },
        {
          "id": "retry-does-not-restore-value",
          "kind": "query",
          "cutoff": "head",
          "query": {
            "kind": "get",
            "entity": "alice",
            "validAt": 1771113600000000
          },
          "expected": {
            "present": false
          }
        },
        {
          "id": "conflicting-request-reuse",
          "kind": "transact",
          "requestId": "correction",
          "operations": [
            {
              "op": "put",
              "entity": "alice",
              "from": 1769904000000000,
              "to": 1772323200000000,
              "value": 76000
            }
          ],
          "expected": {
            "error": "REQUEST_ID_REUSED"
          }
        },
        {
          "id": "conflict-does-not-advance-head",
          "kind": "openView",
          "viewId": "after-conflict",
          "cutoff": "head",
          "expected": {
            "commit": 3
          }
        },
        {
          "id": "lookup-unknown-request",
          "kind": "lookupRequest",
          "requestId": "unsubmitted",
          "expected": {
            "status": "not_found"
          }
        }
      ]
    },
    {
      "id": "operation-order",
      "description": "Unbounded endpoints, intra-transaction overlap, gap refill, coalescing and no-op commits.",
      "steps": [
        {
          "id": "unbounded-values",
          "kind": "transact",
          "requestId": "all-time",
          "operations": [
            {
              "op": "put",
              "entity": "x",
              "from": null,
              "to": null,
              "value": 1
            },
            {
              "op": "put",
              "entity": "zero",
              "from": null,
              "to": null,
              "value": 0
            }
          ],
          "expected": {
            "status": "committed",
            "commit": 1,
            "replayed": false
          }
        },
        {
          "id": "ordered-overlap",
          "kind": "transact",
          "requestId": "overlap",
          "operations": [
            {
              "op": "put",
              "entity": "x",
              "from": 1769904000000000,
              "to": 1772323200000000,
              "value": 2
            },
            {
              "op": "retract",
              "entity": "x",
              "from": 1770681600000000,
              "to": 1771545600000000
            },
            {
              "op": "put",
              "entity": "x",
              "from": 1771113600000000,
              "to": 1773532800000000,
              "value": 3
            }
          ],
          "expected": {
            "status": "committed",
            "commit": 2,
            "replayed": false
          }
        },
        {
          "id": "last-operation-wins",
          "kind": "query",
          "cutoff": 2,
          "query": {
            "kind": "get",
            "entity": "x",
            "validAt": 1771113600000000
          },
          "expected": {
            "present": true,
            "value": 3
          }
        },
        {
          "id": "middle-operation-leaves-gap",
          "kind": "query",
          "cutoff": 2,
          "query": {
            "kind": "get",
            "entity": "x",
            "validAt": 1770854400000000
          },
          "expected": {
            "present": false
          }
        },
        {
          "id": "unbounded-scan",
          "kind": "query",
          "cutoff": 2,
          "query": {
            "kind": "scan",
            "entity": "x",
            "from": null,
            "to": null
          },
          "expected": [
            {
              "from": null,
              "to": 1769904000000000,
              "value": 1
            },
            {
              "from": 1769904000000000,
              "to": 1770681600000000,
              "value": 2
            },
            {
              "from": 1771113600000000,
              "to": 1773532800000000,
              "value": 3
            },
            {
              "from": 1773532800000000,
              "to": null,
              "value": 1
            }
          ]
        },
        {
          "id": "old-unbounded-view",
          "kind": "query",
          "cutoff": 1,
          "query": {
            "kind": "scan",
            "entity": "x",
            "from": null,
            "to": null
          },
          "expected": [
            {
              "from": null,
              "to": null,
              "value": 1
            }
          ]
        },
        {
          "id": "put-into-retracted-gap",
          "kind": "transact",
          "requestId": "refill",
          "operations": [
            {
              "op": "put",
              "entity": "x",
              "from": 1770681600000000,
              "to": 1771113600000000,
              "value": 2
            }
          ],
          "expected": {
            "status": "committed",
            "commit": 3,
            "replayed": false
          }
        },
        {
          "id": "coalesce-equal-neighbors",
          "kind": "query",
          "cutoff": 3,
          "query": {
            "kind": "scan",
            "entity": "x",
            "from": 1769904000000000,
            "to": 1772323200000000
          },
          "expected": [
            {
              "from": 1769904000000000,
              "to": 1771113600000000,
              "value": 2
            },
            {
              "from": 1771113600000000,
              "to": 1772323200000000,
              "value": 3
            }
          ]
        },
        {
          "id": "retract-already-absent",
          "kind": "transact",
          "requestId": "absent-noop",
          "operations": [
            {
              "op": "retract",
              "entity": "missing",
              "from": null,
              "to": null
            }
          ],
          "expected": {
            "status": "committed",
            "commit": 4,
            "replayed": false
          }
        },
        {
          "id": "no-op-retraction-gets-commit",
          "kind": "openView",
          "viewId": "after-noop",
          "cutoff": "head",
          "expected": {
            "commit": 4
          }
        },
        {
          "id": "equal-value-put",
          "kind": "transact",
          "requestId": "equal-noop",
          "operations": [
            {
              "op": "put",
              "entity": "x",
              "from": 1769990400000000,
              "to": 1770076800000000,
              "value": 2
            }
          ],
          "expected": {
            "status": "committed",
            "commit": 5,
            "replayed": false
          }
        },
        {
          "id": "no-op-does-not-fragment-scan",
          "kind": "query",
          "cutoff": 5,
          "query": {
            "kind": "scan",
            "entity": "x",
            "from": 1769904000000000,
            "to": 1771113600000000
          },
          "expected": [
            {
              "from": 1769904000000000,
              "to": 1771113600000000,
              "value": 2
            }
          ]
        },
        {
          "id": "negative-value",
          "kind": "transact",
          "requestId": "negative",
          "operations": [
            {
              "op": "put",
              "entity": "negative",
              "from": null,
              "to": null,
              "value": -5
            }
          ],
          "expected": {
            "status": "committed",
            "commit": 6,
            "replayed": false
          }
        },
        {
          "id": "zero-present-and-negative",
          "kind": "query",
          "cutoff": 6,
          "query": {
            "kind": "sum",
            "entities": [
              "x",
              "zero",
              "negative",
              "missing"
            ],
            "validAt": 1770854400000000
          },
          "expected": {
            "count": 3,
            "sum": "-3"
          }
        },
        {
          "id": "absence-distinct-from-zero",
          "kind": "query",
          "cutoff": 6,
          "query": {
            "kind": "get",
            "entity": "zero",
            "validAt": 1770854400000000
          },
          "expected": {
            "present": true,
            "value": 0
          }
        }
      ]
    },
    {
      "id": "atomic-validation",
      "description": "Whole-request rejection, identity reuse after rejection and query validation.",
      "steps": [
        {
          "id": "seed",
          "kind": "transact",
          "requestId": "seed",
          "operations": [
            {
              "op": "put",
              "entity": "alpha",
              "from": null,
              "to": null,
              "value": 10
            }
          ],
          "expected": {
            "status": "committed",
            "commit": 1,
            "replayed": false
          }
        },
        {
          "id": "pin-before-write",
          "kind": "openView",
          "viewId": "old",
          "cutoff": "head",
          "expected": {
            "commit": 1
          }
        },
        {
          "id": "invalid-second-operation",
          "kind": "transact",
          "requestId": "retryable",
          "operations": [
            {
              "op": "put",
              "entity": "alpha",
              "from": null,
              "to": null,
              "value": 20
            },
            {
              "op": "put",
              "entity": "beta",
              "from": 1769904000000000,
              "to": 1769904000000000,
              "value": 30
            }
          ],
          "expected": {
            "error": "INVALID_REQUEST"
          }
        },
        {
          "id": "no-partial-write",
          "kind": "query",
          "cutoff": "head",
          "query": {
            "kind": "get",
            "entity": "alpha",
            "validAt": 1771113600000000
          },
          "expected": {
            "present": true,
            "value": 10
          }
        },
        {
          "id": "failed-request-not-reserved",
          "kind": "lookupRequest",
          "requestId": "retryable",
          "expected": {
            "status": "not_found"
          }
        },
        {
          "id": "rejection-leaves-head",
          "kind": "openView",
          "viewId": "after-invalid",
          "cutoff": "head",
          "expected": {
            "commit": 1
          }
        },
        {
          "id": "correct-rejected-payload",
          "kind": "transact",
          "requestId": "retryable",
          "operations": [
            {
              "op": "put",
              "entity": "alpha",
              "from": null,
              "to": null,
              "value": 20
            },
            {
              "op": "put",
              "entity": "beta",
              "from": null,
              "to": null,
              "value": 30
            }
          ],
          "expected": {
            "status": "committed",
            "commit": 2,
            "replayed": false
          }
        },
        {
          "id": "whole-transaction-visible",
          "kind": "query",
          "cutoff": 2,
          "query": {
            "kind": "sum",
            "entities": [
              "alpha",
              "beta"
            ],
            "validAt": 1771113600000000
          },
          "expected": {
            "count": 2,
            "sum": "50"
          }
        },
        {
          "id": "old-view-excludes-both-changes",
          "kind": "query",
          "viewId": "old",
          "query": {
            "kind": "sum",
            "entities": [
              "alpha",
              "beta"
            ],
            "validAt": 1771113600000000
          },
          "expected": {
            "count": 1,
            "sum": "10"
          }
        },
        {
          "id": "reject-empty-transaction",
          "kind": "transact",
          "requestId": "empty",
          "operations": [],
